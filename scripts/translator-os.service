[Unit]
Description=AI Translator OS
After=docker.service
Requires=docker.service

[Service]
Type=simple
WorkingDirectory=/opt/translator
ExecStart=/usr/bin/docker compose -f /opt/translator/docker-compose.yml up
ExecStop=/usr/bin/docker compose -f /opt/translator/docker-compose.yml down
User=pi
Restart=always
RestartSec=10
StartLimitIntervalSec=120
StartLimitBurst=3

[Install]
WantedBy=multi-user.target
